generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  passwordHash String
  role         Role             @default(ADMIN)
  createdAt    DateTime         @default(now())
  events       CarouselEvent[]
}

model CarouselEvent {
  id          String   @id @default(uuid())
  eventName   String
  eventDate   DateTime
  message     String?
  imageUrl    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}
